[Unit]
Description=Majiang Algorithm Web Server (FakeLua)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/majiang
Environment=LD_LIBRARY_PATH=/opt/majiang/lib
Environment=MAJIANG_PORT=18090
ExecStart=/opt/majiang/majiangserver_fakelua
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
